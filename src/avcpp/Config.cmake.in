include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(_avcpp_ffmpeg_pc_modules "@FFMPEG_PKGCONFIG_MODULES@")
if(_avcpp_ffmpeg_pc_modules)
    find_dependency(PkgConfig)
    pkg_check_modules(AVCPP_FFMPEG IMPORTED_TARGET ${_avcpp_ffmpeg_pc_modules})
    if(NOT AVCPP_FFMPEG_FOUND)
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "Could not find FFmpeg pkg-config modules: ${_avcpp_ffmpeg_pc_modules}")
        unset(_avcpp_ffmpeg_pc_modules)
        return()
    endif()
endif()
unset(_avcpp_ffmpeg_pc_modules)

@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/avcpp-targets.cmake")
