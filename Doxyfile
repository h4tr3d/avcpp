#---------------------------------------------------------------------------
# Preprocessing
#
# Documents a full-featured modern build: all optional FFmpeg components
# present, C++20, FFmpeg 7.x headers. Without these definitions every
# `#if AVCPP_HAS_*` block is dropped (the macros live in the generated
# avconfig.h, which is not available to the documentation build), and the
# reference silently loses the whole avformat, filter, hardware and subtitle
# layers.
#---------------------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = NO
INCLUDE_PATH           =
INCLUDE_FILE_PATTERNS  =
PREDEFINED             = AVCPP_CXX_STANDARD=20 \
                         AVCPP_HAS_AVCODEC=1 \
                         AVCPP_HAS_AVFORMAT=1 \
                         AVCPP_HAS_AVFILTER=1 \
                         AVCPP_HAS_AVDEVICE=1 \
                         AVCPP_HAS_AVUTIL=1 \
                         AVCPP_HAS_AVSWSCALE=1 \
                         AVCPP_HAS_AVSWRESAMPLE=1 \
                         AVCPP_HAS_HWCONTEXT=1 \
                         AVCPP_HAS_PKT_SIDE_DATA=1 \
                         AVCPP_HAS_FRAME_SIDE_DATA=1 \
                         AVCPP_USE_SPACESHIP_OPERATOR=1 \
                         AVCPP_AVCODEC_VERSION_MAJOR=61 \
                         AVCPP_AVCODEC_VERSION_MINOR=19 \
                         AVCPP_AVCODEC_VERSION_PATCH=100 \
                         AVCPP_AVCODEC_VERSION_INT=4002660 \
                         AVCPP_AVFORMAT_VERSION_MAJOR=61 \
                         AVCPP_AVFORMAT_VERSION_MINOR=7 \
                         AVCPP_AVFORMAT_VERSION_PATCH=100 \
                         AVCPP_AVFORMAT_VERSION_INT=3999588 \
                         AVCPP_AVUTIL_VERSION_MAJOR=59 \
                         AVCPP_AVUTIL_VERSION_MINOR=39 \
                         AVCPP_AVUTIL_VERSION_PATCH=100 \
                         AVCPP_AVUTIL_VERSION_INT=3876708 \
                         AVCPP_AVFILTER_VERSION_MAJOR=10 \
                         AVCPP_AVFILTER_VERSION_MINOR=4 \
                         AVCPP_AVFILTER_VERSION_PATCH=100 \
                         AVCPP_AVFILTER_VERSION_INT=656484 \
                         AVCPP_AVDEVICE_VERSION_MAJOR=61 \
                         AVCPP_AVDEVICE_VERSION_MINOR=3 \
                         AVCPP_AVDEVICE_VERSION_PATCH=100 \
                         AVCPP_AVDEVICE_VERSION_INT=3998564 \
                         AVCPP_SWSCALE_VERSION_MAJOR=8 \
                         AVCPP_SWSCALE_VERSION_MINOR=3 \
                         AVCPP_SWSCALE_VERSION_PATCH=100 \
                         AVCPP_SWRESAMPLE_VERSION_MAJOR=5 \
                         AVCPP_SWRESAMPLE_VERSION_MINOR=3 \
                         AVCPP_SWRESAMPLE_VERSION_PATCH=100 \
                         "AV_VERSION_INT(a,b,c)=((a<<16)|(b<<8)|(c))"
EXPAND_AS_DEFINED      =
SKIP_FUNCTION_MACROS   = YES

