 */

/**
 * @example api2-hw-transcode.cpp
 * Аппаратное транскодирование.
 *
 * @code{.sh}
 * api2-hw-transcode <тип устройства> <входной файл> <выходной файл>
 * @endcode
 */

/**
 * @example api2-remux.cpp
 * Ремиксинг.
 *
 * @code{.sh}
 * api2-remux [параметры] <вход> <выход>
